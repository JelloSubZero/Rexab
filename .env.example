# Telegram bot
BOT_TOKEN=токен_бота_из_BotFather
BOT_USERNAME=username_бота_без_@

# База данных (SQLite для dev/test, Postgres для прода)
DATABASE_URL=sqlite+aiosqlite:///split_receipt.db

# OCR (необязательно, есть значения по умолчанию)
OCR_LANGUAGES=pol+eng+rus
TESSERACT_PATH=

# Web API — JWT
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# Web API — CORS, через запятую
CORS_ORIGINS=http://localhost:3000

# Логирование: DEBUG/INFO/WARNING/ERROR. Пишется в консоль и logs/rexab.log
LOG_LEVEL=INFO
